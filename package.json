{
  "name": "@derion/sdk",
  "version": "3.0.1",
  "description": "TypeScript SDK for the Derion protocol",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "vendor"
  ],
  "scripts": {
    "build": "tsc",
    "pretty": "prettier --write \"./src/**/*.ts\"",
    "test": "jest",
    "prepare": "tsc",
    "prepublishOnly": "npm run build"
  },
  "author": "Derion Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/derion-io/sdk.git"
  },
  "dependencies": {
    "@ethersproject/providers": "file:vendor/providers",
    "ethereum-multicall": "^2.15.0",
    "ethers": "^5.5.4",
    "move-decimal-point": "^0.0.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "jest": "^29.7.0",
    "prettier": "2.8.8",
    "ts-jest": "^29.1.1",
    "typescript": "4"
  }
}
